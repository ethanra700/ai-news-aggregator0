# Postgres settings for docker-compose.yml.
# Copy this file to docker/.env and change the values if you like (docker/.env is not committed).
# If you change them, update DATABASE_URL in the root .env to match:
#   postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
POSTGRES_USER=ai_news
POSTGRES_PASSWORD=ai_news_password
POSTGRES_DB=ai_news
POSTGRES_PORT=5433
